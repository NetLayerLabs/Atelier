# ---------------------------------------------------------------------------
# Atelier backend configuration. Copy to `.env` (git-ignored) and edit.
# There is no mock mode: a service is used when its vars below are set. Anything not set (or failing) is
# reported as "not connected" with a setup hint, and the features that need it fail honestly with a retry —
# nothing is ever made up in its place. With an empty file the app runs and shows what to connect.
# ---------------------------------------------------------------------------

# --- THE model: Gemma 4 on our own vLLM on an AMD Instinct MI300X (docs/AMD_SETUP.md, CONTRACT.md "v6") ---
# Default plan: ONE server (deploy/serve_llm.sh) serves google/gemma-4-26B-A4B-it; it writes the tech packs / RFQs
# AND reads the mood boards, so the vision vars below point at the same endpoint and model.
# OpenAI-compatible base URL of vLLM on AMD Developer Cloud (".../v1" optional, added if missing)
# e.g. http://127.0.0.1:18000/v1 through deploy/tunnel.sh
AMD_VLLM_ENDPOINT=
# Model id as served by vLLM (google/gemma-4-26B-A4B-it); empty = the first model from GET /v1/models
AMD_VLLM_MODEL=
# Bearer key if you started vLLM with --api-key (also used for the vision endpoint)
AMD_VLLM_API_KEY=

# --- Vision (trend analysis from mood boards) --------------------------------
# Default: the SAME Gemma 4 server and model as AMD_VLLM_* (Gemma 4 reads images). Up to
# ATELIER_VISION_MAX_IMAGES (4) images per prompt, matching the server's --limit-mm-per-prompt.
AMD_VISION_ENDPOINT=
AMD_VISION_MODEL=
# ATELIER_VISION_MAX_IMAGES=4
# The one-model plan through deploy/tunnel.sh, filled in:
#   AMD_VLLM_ENDPOINT=http://127.0.0.1:18000/v1      AMD_VLLM_MODEL=google/gemma-4-26B-A4B-it
#   AMD_VISION_ENDPOINT=http://127.0.0.1:18000/v1    AMD_VISION_MODEL=google/gemma-4-26B-A4B-it
# (Left empty here so an unedited copy reports "not connected" instead of probing a tunnel that isn't up.)

# --- Diffusion (design concepts) ----------------------------------------------
# Full URL. Assumed contract: POST {prompt, negative_prompt, seed, width, height} -> {images: [base64]}
# Adapt app/services/diffusion.py::_call_diffusion_endpoint for A1111 / ComfyUI / custom servers.
AMD_DIFFUSION_ENDPOINT=

# What the GPU really is, shown in the Inference panel (e.g. "AMD Instinct MI300X" — copy it from rocm-smi).
# Leave empty rather than guess: no GPU is claimed without it.
AMD_GPU_LABEL=
# Only if deploy/diffusion_server.py runs with DIFFUSION_API_KEY
AMD_DIFFUSION_API_KEY=

# --- Evolus business agent (docs: https://evolus.ai/developers; setup: docs/EVOLUS_SETUP.md) ---
EVOLUS_API_BASE=https://api.evolus.ai
# Application API key from the workspace "API keys" page  -> header X-ApiKey
EVOLUS_API_KEY=
# The workspace / space id shown on that page              -> header X-Application-Id
EVOLUS_WORKSPACE_ID=
EVOLUS_OUTREACH_WORKFLOW_ID=
EVOLUS_SHOPIFY_WORKFLOW_ID=

# --- v3: Evolus is the agent's brain + real supplier quotes (docs/EVOLUS_SETUP.md) ---
# The Evolus agent whose model is our AMD vLLM endpoint: "<spaceId>:<agentId>" (GET /v1/models lists them).
# Set -> tech packs, RFQs, creative direction and the supplier rationale go through it (else direct vLLM, else an error).
EVOLUS_AGENT_MODEL=
# Shown in logs, e.g. "gemma-4-26B-A4B-it on MI300X"
# Where the agent's own model is served, shown in routes/logs: "AMD vLLM" (own droplet) or "AMD Token Factory"
EVOLUS_AGENT_BACKEND=AMD vLLM
EVOLUS_AGENT_LABEL=
# "openai" (POST /v1/chat/completions, documented) or "rest" (POST /api/v1/agents/{id}/ask, returns library citations)
EVOLUS_AGENT_TRANSPORT=openai
# Knowledge library (brand book + supplier catalogue) attached to the agent
EVOLUS_LIBRARY_ID=
# Optional personal key (Profile -> API keys) if library calls get 401 with the application key
EVOLUS_USER_API_KEY=
# Name of the AMD model on the workspace's Models page (provision_evolus.py -> agent modelKey "own/<name>")
EVOLUS_OWN_MODEL_NAME=
# Document extractor "Supplier quote": POST /api/v1/agents/{agentId}/json/{extractorId}/ask-file
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_EXTRACTOR_ID=
# Email-triggered workflow (inbound quote -> extractor -> our webhook); only scripts/check_evolus.py uses the id
EVOLUS_INBOUND_WORKFLOW_ID=
# Shared secret the inbound workflow sends as X-Atelier-Webhook-Secret to POST /api/webhooks/evolus/quote.
# Empty = webhook disabled (503). Generate: openssl rand -hex 24
EVOLUS_WEBHOOK_SECRET=
# EVOLUS_WEBHOOK_HEADER=X-Atelier-Webhook-Secret
# true = also polish each RFQ with the Evolus "email" AI Tool (uses platform credits)
EVOLUS_RFQ_AI_TOOL=false

# --- v5: Brand workspace (CONTRACT.md "v5", docs/PILOT_DATA.md) ------------------------
# The brand's own data — profile, brand book, supplier directory (real contacts, per-supplier RFQ override),
# material price list, guardrails, sales history — is imported in the UI (Brand workspace) and stored here:
# a SQLite file + uploaded files, plus sequences.json (the brand's PO-00001 / ST-00001 numbers).
# Default backend/var/ (git-ignored); Docker uses the /data volume.
# ATELIER_DATA_DIR=
# Which brand's PO / style number sequence to use (one brand per data dir).
# ATELIER_BRAND_ID=default

# Quotes are real documents (upload, or email -> Evolus extractor -> webhook). Never simulated.
# 0 = the quotes step waits until every RFQ'd mill replied or the CD clicks "Stop waiting & recommend"
ATELIER_QUOTE_WAIT_SECONDS=0

# --- v4: brand guardrails + human hand-off (CONTRACT.md "v4") -----------------------
# v5: the guardrails are set by the brand in the Brand workspace (no env defaults; unset rules aren't checked).
# When the agent's pick breaks one, the run stops and a person approves (override), switches supplier or negotiates.
# Counter-offers are sent through this Evolus workflow (same flat parameters as outreach + kind=counter_offer).
# Empty = EVOLUS_OUTREACH_WORKFLOW_ID. Neither set -> the draft is kept and nothing is sent ("not connected").
EVOLUS_NEGOTIATION_WORKFLOW_ID=
# v5: purchase orders are sent to the selected mill through this Evolus workflow (outreach params + kind=purchase_order,
# po_number, quantity, unit_price, currency, total). Empty = the outreach workflow. Neither -> "draft — not sent".
EVOLUS_PO_WORKFLOW_ID=
# Translate quote notes written in another language (the brain; without one the note stays untranslated, labelled)
ATELIER_TRANSLATE_NOTES=true
# FX for quotes in another currency: the ECB daily euro reference rates (free, no key), cached for a day.
# If unavailable, the quote stays in its own currency and is marked "not converted".
# ATELIER_FX_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
# Correctable on site without code changes, if the in-workspace API reference differs:
# EVOLUS_EXECUTE_PATH=/api/v1/workflows/{workflow_id}/execute
# EVOLUS_STATUS_PATH=/api/v1/workflows/{workflow_id}/executions/{execution_id}
# EVOLUS_PROBE_PATH=/api/v1/ai-tools
# EVOLUS_SEND_PARAMETERS=true
# EVOLUS_POLL_INTERVAL=1.5
# EVOLUS_POLL_TIMEOUT=60

# --- Shopify: REAL pre-orders (setup: docs/SHOPIFY_SETUP.md) ----------------------
# Once these are set, the pre-order product and its orders are real.
# Without them the pipeline stops at "Shopify not connected" (with a retry once you've set them).
SHOPIFY_STORE_DOMAIN=
# Dev Dashboard app (Settings): the backend exchanges these for a 24h token (client-credentials grant)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or a permanent Admin API token from a legacy custom app (created before 2026-01-01)
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Dev-store storefront password; shown under the QR code only when set
SHOPIFY_STOREFRONT_PASSWORD=
# Optional short link to the product page, shown on stage (the QR code always encodes the full URL)
SHOPIFY_SHORT_URL=
# Verifies X-Shopify-Hmac-Sha256 on POST /api/webhooks/shopify/orders-create; defaults to SHOPIFY_CLIENT_SECRET
SHOPIFY_WEBHOOK_SECRET=
# Seconds between Admin API order polls (works from localhost, no public URL needed)
SHOPIFY_POLL_INTERVAL=4
# Count test-payment orders (a dev store only takes test orders); they are always labelled "test order"
SHOPIFY_COUNT_TEST_ORDERS=true
# Real window length in hours (14 days)
SHOPIFY_DEMAND_WINDOW_HOURS=336
# Stage demo: this many REAL pre-orders unlock the PO instead of the production plan (e.g. 300 units).
# Shown on screen as "stage threshold: N pre-orders (production plan: P units)". 0 = use the production threshold.
DEMAND_STAGE_THRESHOLD=5

# --- Serving -------------------------------------------------------------------
# Used to build absolute image / quote-document URLs (must be reachable by the browser)
PUBLIC_BASE_URL=http://localhost:8787
# Comma-separated list of allowed frontend origins. Also the Origin check: a POST / PUT / PATCH / DELETE whose
# Origin (or Referer) is not listed here is rejected (403) — webhooks excepted (they are signed).
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000

# --- Access (QA H5) ---------------------------------------------------------------
# Unset: only this machine may change data (loopback clients; ATELIER_TRUSTED_NETWORKS adds CIDRs, e.g. Docker's
# bridge in docker-compose.yml). Set it before exposing the API to anyone else (a server, a reverse proxy, a tunnel):
# every change then needs `Authorization: Bearer <token>` or the dashboard's sign-in, and quote documents / brand
# files and customers' first names are only served to signed-in clients.
# ATELIER_ADMIN_TOKEN=
# ATELIER_TRUSTED_NETWORKS=

# --- Backend-only knobs (not in CONTRACT.md) --------------------------------------
# Timeouts in seconds. A timeout / connection error is not retried (only an invalid answer is), so these are also
# roughly the longest a failing step waits.
ATELIER_LLM_TIMEOUT=45
ATELIER_DIFFUSION_TIMEOUT=120
ATELIER_EVOLUS_TIMEOUT=45
ATELIER_VISION_TIMEOUT=45
ATELIER_EXTRACTOR_TIMEOUT=60
EVOLUS_AGENT_TIMEOUT=60
# /api/health probes: per-probe timeout and cache lifetime
ATELIER_HEALTH_TIMEOUT=2.5
ATELIER_HEALTH_CACHE_SECONDS=5
# LLM request knobs: streaming (gives time-to-first-token), JSON mode on the first attempt,
# and extra JSON merged into every chat request. Thinking OFF for the strict-JSON calls: Gemma 4's chat template
# reads chat_template_kwargs.enable_thinking (default false, set explicitly here); Qwen3.x uses the same key:
ATELIER_LLM_STREAM=true
ATELIER_LLM_JSON_MODE=true
ATELIER_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# Live diffusion output size
ATELIER_DIFFUSION_WIDTH=768
ATELIER_DIFFUSION_HEIGHT=1024
