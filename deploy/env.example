# Copy to deploy/.env ON THE AMD GPU BOX and edit. Read by serve_*.sh. Never commit the real file.

# Required: bearer key for the vLLM servers (generate: openssl rand -hex 24).
# The same value goes into backend/.env as AMD_VLLM_API_KEY and into the Evolus "model" connection.
VLLM_API_KEY=

# Needed for gated models (FLUX.1-schnell): accept the license on huggingface.co first. Gemma 4 is not gated.
HF_TOKEN=

# Model cache on the big scratch disk if the droplet has one (check `df -h`), else ~/.cache/huggingface
HF_CACHE=/root/.cache/huggingface

# --- THE model: Gemma 4 on vLLM (port 8000, public so Evolus can reach it; protected by VLLM_API_KEY) ---
# One server is the text brain, the vision model and the Evolus workspace model (docs/AMD_SETUP.md).
# Gemma 4 needs vLLM >= 0.19.1; serve_llm.sh checks the image before starting. v0.31.0 (2026-10-04) is on Docker Hub.
VLLM_IMAGE=vllm/vllm-openai-rocm:v0.31.0
LLM_MODEL=google/gemma-4-26B-A4B-it
# LLM_MODEL=google/gemma-4-31B-it      # dense 31B, ~62 GB BF16 (estimate): slower, more memory
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B       # alternative (NOT Gemma: no Google prize); parsers switch to qwen3_coder/qwen3
LLM_PORT=8000
LLM_BIND=0.0.0.0
# vLLM never fetches image URLs (the backend sends bytes): --allowed-media-domains is pinned to "media.invalid".
# Only widen it (space-separated hosts) if a client you trust must pass image URLs.
# VLLM_ALLOWED_MEDIA_DOMAINS=
LLM_GPU_UTIL=0.60
LLM_MAX_MODEL_LEN=32768
# Picked from the model family by serve_llm.sh; uncomment only to override (an empty value drops the flag):
#   gemma-4: --tool-call-parser gemma4 --reasoning-parser gemma4 --chat-template templates/tool_chat_template_gemma4.jinja
#            --limit-mm-per-prompt '{"image": 4, "audio": 0}'
#   qwen3*:  --tool-call-parser qwen3_coder --reasoning-parser qwen3 --limit-mm-per-prompt '{"image": 4}'
#   other:   --tool-call-parser hermes
# LLM_TOOL_PARSER=gemma4
# LLM_REASONING_PARSER=gemma4
# LLM_CHAT_TEMPLATE=/srv/deploy/templates/tool_chat_template_gemma4.jinja
# LLM_LIMIT_MM='{"image": 4, "audio": 0}'      # quoted: this file is sourced by bash
LLM_EXTRA_ARGS=
# SKIP_VLLM_VERSION_CHECK=1

# --- OPTIONAL separate vision server (port 8001, localhost only). Leave VLM_MODEL empty in the default plan:
# Gemma 4 on port 8000 reads the images. Set it only to isolate vision, e.g. google/gemma-4-12B-it.
VLM_MODEL=
VLM_PORT=8001
VLM_BIND=127.0.0.1
VLM_GPU_UTIL=0.18
VLM_MAX_MODEL_LEN=16384
VLM_EXTRA_ARGS=

# --- diffusion (port 8002, localhost only) ----------------------------------------------------------
TORCH_IMAGE=rocm/pytorch:rocm10.1.0_ubuntu24.04_py3.12_pytorch_release_2.13.0
DIFFUSION_MODEL=black-forest-labs/FLUX.1-schnell
DIFFUSION_PORT=8002
DIFFUSION_BIND=127.0.0.1
DIFFUSION_API_KEY=

# AMD AITER kernels for vLLM on MI300X. If a server fails to start, try 0.
VLLM_ROCM_USE_AITER=1
